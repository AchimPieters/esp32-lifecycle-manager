#
# StudioPieters
#

# General Optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Smaller printf/scanf implementation. Safe here: no floating-point, 64-bit or
# positional format specifiers are used anywhere in the firmware, so behaviour is
# unchanged. printf is not on any hot path, so there is no speed impact.
CONFIG_NEWLIB_NANO_FORMAT=y

# Silent assertions: assert()/configASSERT still evaluate and still abort on a
# failed invariant (identical protective behaviour and speed), but the file/line
# message strings are dropped, removing a large amount of string data pulled in
# from ESP-IDF components.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y


# Binary Size Reduction
# Enable info-level logging so runtime messages like WiFi readiness are visible
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# TLS cert bundle
# The "common" set (most widely used roots, incl. the DigiCert/Sectigo roots
# behind api.github.com and the GitHub release CDN) is considerably smaller than
# the full bundle. If GitHub ever rotates to a root outside this set, OTA will
# fail TLS until you switch back to CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set


# RAM Usage Minimization
# CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=512
# CONFIG_FREERTOS_ISR_STACKSIZE=1536
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y

#
# ESP32 Captive Portal
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10500
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

